# Production: public GitHub repositories fetched only on requests.
NABOUS_PROJECTS='[{"slug":"slidebox","repository":"monabbous/slidebox","ref":"main"}]'
NABOUS_CONTENT_CACHE_SECONDS=0

# Local `pnpm dev`: replace NABOUS_PROJECTS above with a local checkout.
# The path is the repository root, not its public directory.
# NABOUS_PROJECTS='[{"slug":"slidebox","path":"/absolute/path/to/slidebox"}]'
